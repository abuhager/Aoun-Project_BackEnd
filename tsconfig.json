{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "types": ["node", "multer"],
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": [
    "*.ts",
    "config/**/*.ts",
    "controllers/**/*.ts",
    "dtos/**/*.ts",
    "integrations/**/*.ts",
    "jobs/**/*.ts",
    "middlewares/**/*.ts",
    "models/**/*.ts",
    "repositories/**/*.ts",
    "routes/**/*.ts",
    "scripts/**/*.ts",
    "services/**/*.ts",
    "socket/**/*.ts",
    "utils/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "test"]
}
