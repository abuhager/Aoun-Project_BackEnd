{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "noEmit": true
  },
  "include": [
    "*.ts",
    "config/**/*.ts",
    "controllers/**/*.ts",
    "dtos/**/*.ts",
    "integrations/**/*.ts",
    "jobs/**/*.ts",
    "middlewares/**/*.ts",
    "models/**/*.ts",
    "repositories/**/*.ts",
    "routes/**/*.ts",
    "scripts/**/*.ts",
    "services/**/*.ts",
    "socket/**/*.ts",
    "utils/**/*.ts",
    "types/**/*.d.ts"
  ]
}
