{
  "name": "aoun-backend",
  "version": "1.0.0",
  "description": "REST and Socket.IO backend for the Aoun donation platform",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "dev": "tsx watch server.ts",
    "worker:dev": "tsx watch worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test",
    "check": "npm run typecheck",
    "verify": "npm run typecheck && npm test && npm run build",
    "db:indexes": "tsx utils/ensureIndexes.ts",
    "db:indexes:verify": "tsx utils/ensureIndexes.ts --verify",
    "db:periods:check": "tsx scripts/backfill-donation-request-period.ts",
    "db:periods:apply": "tsx scripts/backfill-donation-request-period.ts --apply",
    "db:orphans:audit": "tsx scripts/audit-item-references.ts",
    "db:search:check": "tsx scripts/backfill-item-search.ts",
    "db:search:apply": "tsx scripts/backfill-item-search.ts --apply",
    "db:seed:mock": "tsx scripts/seed-mock-data.ts",
    "perf:smoke": "tsx scripts/load-smoke.ts"
  },
  "keywords": [],
  "author": "Adham Abu Hager",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "firebase-admin": "^14.1.0",
    "helmet": "^8.1.0",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "rate-limit-redis": "^5.0.0",
    "redis": "^6.0.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abuhager/Aoun-Project_BackEnd.git"
  },
  "bugs": {
    "url": "https://github.com/abuhager/Aoun-Project_BackEnd/issues"
  },
  "homepage": "https://github.com/abuhager/Aoun-Project_BackEnd#readme"
}
