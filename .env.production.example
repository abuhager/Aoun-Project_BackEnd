# انسخ القيم إلى لوحة الاستضافة فقط. لا ترفع ملف .env الحقيقي إلى Git.
NODE_ENV=production
PORT=5000

# استخدم single لنسخة واحدة، أو distributed مع Redis عند تشغيل عدة نسخ Web.
RUNTIME_TOPOLOGY=single
WEB_CONCURRENCY=1
BACKGROUND_JOBS_REQUIRED=true

# شغّل Background Worker مستقل بالأمر npm run worker.
OUTBOX_WORKER_REQUIRED=true
METRICS_ENABLED=true
METRICS_TOKEN=replace-with-a-random-secret-at-least-32-characters
# أنشئه مرة واحدة: openssl rand -hex 32 — لا تغيّره ما دامت أحداث معلقة.
OUTBOX_ENCRYPTION_KEY=replace-with-64-hex-characters
OUTBOX_POLL_MS=2000
OUTBOX_LOCK_TIMEOUT_MS=120000
OUTBOX_BATCH_SIZE=20
OUTBOX_HEARTBEAT_MAX_AGE_MS=90000

MONGO_URI=mongodb+srv://replace-with-production-connection/aoun
MONGO_AUTO_INDEX=false
MONGO_SYNC_INDEXES_ON_STARTUP=false
MONGO_INDEXES_REQUIRED=true

# يوصى به حتى مع نسخة واحدة لتثبيت Rate Limiting عبر إعادة التشغيل.
REDIS_REQUIRED=true
REDIS_URL=rediss://replace-with-managed-redis

JWT_SECRET=replace-with-64-random-characters
JWT_REFRESH_SECRET=replace-with-another-64-random-characters
COOKIE_SECRET=replace-with-a-third-64-random-characters
OTP_PEPPER=replace-with-a-fourth-64-random-characters
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

ALLOWED_ORIGINS=https://replace-with-frontend-domain
CLIENT_URL=https://replace-with-frontend-domain

CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-secret

BREVO_API_KEY=replace-with-brevo-key
PLATFORM_EMAIL=noreply@replace-with-verified-domain

# اتركها false إذا لم تكن Firebase Phone Auth جاهزة بالكامل.
PHONE_VERIFICATION_ENABLED=false
PHONE_VERIFICATION_PROMOTES_TRUST=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
